# Copy to .env.local for local development (`npm run dev`), and set the same two
# variables in Vercel (Project → Settings → Environment Variables) for production.
# Both come from the Supabase dashboard: the project's "Connect" button, or
# Project Settings → API Keys. Use the publishable (or legacy "anon") key —
# never the secret / service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
